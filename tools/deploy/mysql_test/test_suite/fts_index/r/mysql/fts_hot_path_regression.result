# full-text index build and MATCH queries
create table docs(
id bigint primary key,
title varchar(128),
content text,
title_en varchar(128),
content_en text,
fulltext key fti_all_ik(title, content) with parser ik,
fulltext key fti_en(title_en, content_en) with parser beng
);
insert into docs values
(1, '全文索引', '全文索引的分词器把文本拆成词', 'Full Text', 'database performance audit trail'),
(2, '分词器', '分词器热路径优化', 'Tokenizer', 'tokenizer hot path for the database'),
(3, '数据库', 'OceanBase 是稳定的数据库', 'Database', 'a stable distributed database'),
(4, '倒排索引', '倒排索引的构建和查询', 'Inverted Index', 'inverted index build and query'),
(5, '无关', '今天天气很好', 'Weather', 'sunny weather today'),
(6, '全文索引 分词器', '全文索引与分词器 全文索引', 'Audit', 'performance audit of the AUDIT log'),
(7, 'OceanBase', 'oceanbase 稳定 高效', 'OceanBase', 'OceanBase database performance');
select id from docs where match(title, content) against('全文索引 分词器') order by id;
id
1
2
6
select count(*) from docs where match(title, content) against('全文索引 分词器');
count(*)
3
select id from docs where match(title_en, content_en) against('database performance audit') order by id;
id
1
2
3
6
7
select count(*) from docs where match(title_en, content_en) against('database performance audit');
count(*)
5
select id from docs where match(title, content) against('OceanBase 稳定 database') order by id;
id
3
7
select count(*) from (select id from docs where match(title, content) against('全文索引 分词器') limit 2) t;
count(*)
2
select id, round(match(title, content) against('全文索引 分词器'), 4) as score
from docs where match(title, content) against('全文索引 分词器') order by score desc, id;
id	score
6	1.7445
1	1.4225
2	0.4021
# a filter on the score is still evaluated as written
select id from docs where match(title, content) against('全文索引 分词器') > 1 order by id;
id
1
6
# the index keeps working after DML
update docs set content = '分词器' where id = 5;
delete from docs where id = 1;
select id from docs where match(title, content) against('全文索引 分词器') order by id;
id
2
5
6
drop database fts_hot_path;
