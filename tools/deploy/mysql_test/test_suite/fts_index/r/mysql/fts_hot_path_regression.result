drop database if exists fts_hot_path;
create database fts_hot_path;
use fts_hot_path;
set names utf8mb4;
# TOKENIZE keeps its output for both parsers and both IK modes
select tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术，在大量文档索引和查询场景下可以显著降低 CPU 开销。', 'ik');
tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术，在大量文档索引和查询场景下可以显著降低 CPU 开销。
["技术", "一款", "是", "在", "显著", "场景", "下", "的", "全文索引", "开销", "内存", "分词器", "cpu", "数据结构", "热", "非常", "索引", "化", "池", "大量", "停", "实例", "等", "oceanbase", "可以", "单", "稳定", "复用", "数据库", "和", "包括", "查询", "优化", "路径", "用词", "降低", "文档", "全局", "解析器", "例"]
select tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术，在大量文档索引和查询场景下可以显著降低 CPU 开销。', 'ik', '[{"output": "all"}]');
tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例、内存池化数据结构等技术，在大量文档索引和查询场景下可以显著降低 CPU 开销。
{"tokens": [{"技术": 1}, {"一款": 1}, {"是": 1}, {"在": 1}, {"显著": 1}, {"场景": 1}, {"下": 1}, {"的": 2}, {"全文索引": 1}, {"开销": 1}, {"内存": 1}, {"分词器": 1}, {"cpu": 1}, {"数据结构": 1}, {"热": 1}, {"非常": 1}, {"索引": 1}, {"化": 1}, {"池": 1}, {"大量": 1}, {"停": 1}, {"实例": 1}, {"等": 1}, {"oceanbase": 1}, {"可以": 1}, {"单": 1}, {"稳定": 1}, {"复用": 1}, {"数据库": 1}, {"和": 1}, {"包括": 1}, {"查询": 1}, {"优化": 1}, {"路径": 1}, {"用词": 1}, {"降低": 1}, {"文档": 1}, {"全局": 1}, {"解析器": 1}, {"例": 1}], "doc_len": 41}
select tokenize('一千二百三十四万五千六百七十八点九 2026年11月6日 第三百零五号 二〇二六', 'ik');
tokenize('一千二百三十四万五千六百七十八点九 2026年11月6日 第三百零五号 二〇二六', 'ik')
["二六", "2026年", "二", "第", "三百零五号", "一千二百三十四万五千六百七十八", "11月", "6日", "九", "点"]
select tokenize('壹佰贰拾叁 廿 卅 两千零一夜 十万八千里', 'ik', '[{"additional_args":[{"ik_mode":"max_word"}]}]');
tokenize('壹佰贰拾叁 廿 卅 两千零一夜 十万八千里', 'ik', '[{"additional_args":[{"ik_mode":"max_word"}]}]')
["两", "两千", "卅", "里", "十万八千里", "八千", "一夜", "千", "两千零一", "千里", "十万八千", "廿", "零", "壹佰贰拾叁", "十万"]
select tokenize('The Quick BROWN fox jumps over the lazy dog. Full-Text Search requires efficient tokenization.', 'beng');
tokenize('The Quick BROWN fox jumps over the lazy dog. Full-Text Search requires efficient tokenization.', 'beng')
["lazy", "text", "efficient", "over", "tokenization", "quick", "full", "requires", "dog", "brown", "fox", "jumps", "search"]
select tokenize('MiXeD Case 混合 CASE 大小写 ÉCOLE École', 'ik');
tokenize('MiXeD Case 混合 CASE 大小写 ÉCOLE École', 'ik')
["case", "大小写", "混合", "mixed", "cole"]
# repeated calls reuse the cached dictionary loader
select tokenize('全文索引 分词器', 'ik') = tokenize('全文索引 分词器', 'ik') as same_result;
same_result
1
# utf8mb4_general_ci comparison: ASCII case folding, CJK, accents, padding and 4-byte characters
create table words(id int primary key, w varchar(32) collate utf8mb4_general_ci, b varbinary(32));
insert into words values
(1, 'abc', 'abc'), (2, 'ABC', 'ABC'), (3, 'abd', 'abd'), (4, 'ab', 'ab'), (5, 'ab ', 'ab '),
(6, '全文', '全文'), (7, '全文索引', '全文索引'), (8, '分词', '分词'), (9, '索引', '索引'),
(10, 'école', 'école'), (11, 'ECOLE', 'ECOLE'), (12, 'Ecole', 'Ecole'), (13, '😀', '😀'),
(14, '😃', '😃'), (15, 'a_b', 'a_b'), (16, 'a^b', 'a^b'), (17, 'aZb', 'aZb'), (18, '', ''),
(19, '全文a', '全文a'), (20, '全文A', '全文A'), (21, 'zz', 'zz'), (22, '一', '一'), (23, '鿿', '鿿'),
(24, '㐀', '㐀'), (25, 'x全', 'x全'), (26, 'X全', 'X全'), (27, '全 ', '全 ');
