--exec base64 -d < $FILE_SQL_EXT_DIR/items.parquet.b64 > $FILE_SQL_EXT_DIR/items.parquet

set session enable_file_sql = ON;

--echo # CSV options: delimiter, NULL text, quotes with delimiters, line breaks and escapes
eval select order_id, customer, amount, paid, replace(note, char(10), '<NL>') as note
       from read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA')
      order by order_id;
eval select * from read_csv('$FILE_SQL_EXT_DIR/escapes.csv', escape = '\\\\') order by id;
eval select * from read_csv('$FILE_SQL_EXT_DIR/no_header.csv', header = false, skip = 1) t;

--echo # deterministic type inference: widening, int64 bounds, invalid dates and all NULL columns
eval describe select * from read_csv('$FILE_SQL_EXT_DIR/types.csv');
eval select i, d, b, mixed, dt, bad_date, big, neg, empty_col from read_csv('$FILE_SQL_EXT_DIR/types.csv') order by i;

--echo # malformed rows are reported with their line, or skipped with ignore_errors
--replace_regex /file '[^']*'/file '<path>'/
--error 11121
eval select * from read_csv('$FILE_SQL_EXT_DIR/bad_rows.csv');
eval select * from read_csv('$FILE_SQL_EXT_DIR/bad_rows.csv', ignore_errors = true) order by id;
--replace_regex /file '[^']*'/file '<path>'/
--error 11121
eval select * from read_csv('$FILE_SQL_EXT_DIR/unterminated.csv');

--echo # JSONL: union of keys in first-seen order, missing keys are NULL, conflicts become VARCHAR
eval describe select * from read_ndjson('$FILE_SQL_EXT_DIR/customers.jsonl');
eval select customer, city, since, vip, score from read_json('$FILE_SQL_EXT_DIR/customers.jsonl') order by customer;
--replace_regex /file '[^']*'/file '<path>'/
--error 11121
eval select * from read_json('$FILE_SQL_EXT_DIR/nested.jsonl');
--replace_regex /file '[^']*'/file '<path>'/
--error 11121
eval select * from read_json('$FILE_SQL_EXT_DIR/broken.jsonl');
--error 1235
eval select * from read_json('$FILE_SQL_EXT_DIR/customers.jsonl', format = 'array');

--echo # Parquet: three row groups, nullable columns, projection of a subset of the columns
eval describe select * from read_parquet('$FILE_SQL_EXT_DIR/items.parquet');
eval select id, grp, qty, price, ok, day, ts from read_parquet('$FILE_SQL_EXT_DIR/items.parquet') order by id;
eval select count(*), count(grp), sum(qty), round(sum(price), 2), sum(ok), min(day), max(ts)
       from read_parquet('$FILE_SQL_EXT_DIR/items.parquet');

--echo # single file SQL: expressions, filter, grouping, HAVING, ordering and LIMIT
eval select grp, count(*) as n, sum(qty) as total, round(avg(price), 3) as avg_price
       from read_parquet('$FILE_SQL_EXT_DIR/items.parquet') p
      where id > 1 and grp is not null
      group by grp having count(*) > 1
      order by total desc limit 2;

--echo # joins between files: inner, left and across formats, executed by the seekdb engine
eval select o.order_id, o.customer, c.city
       from read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA') o
       join read_json('$FILE_SQL_EXT_DIR/customers.jsonl') c on o.customer = c.customer
      order by o.order_id;
eval select c.customer, count(o.order_id) as orders
       from read_json('$FILE_SQL_EXT_DIR/customers.jsonl') c
       left join read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA') o on o.customer = c.customer
      group by c.customer order by c.customer;
eval select p.id, p.grp, o.customer
       from read_parquet('$FILE_SQL_EXT_DIR/items.parquet') p
       join read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA') o on p.id = o.order_id
      order by p.id;
--replace_regex /value\(\[.*\]\)/value(<file>)/
eval explain basic select count(*)
       from read_parquet('$FILE_SQL_EXT_DIR/items.parquet') p
       join read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA') o on p.id = o.order_id;

--echo # COPY options and read back; an existing target is never replaced
eval copy (select order_id, customer, amount, note
             from read_csv('$FILE_SQL_EXT_DIR/orders.csv', delim = ';', nullstr = 'NA') order by order_id)
       to '$FILE_SQL_EXT_DIR/orders_out.csv' (format csv, header, delimiter '|', nullstr '-');
eval select order_id, customer, amount, replace(note, char(10), '<NL>') as note
       from read_csv('$FILE_SQL_EXT_DIR/orders_out.csv', delim = '|', nullstr = '-') order by order_id;
--error 1086
eval copy (select 1 as x) to '$FILE_SQL_EXT_DIR/orders_out.csv';
eval copy (select 1 as x) to '$FILE_SQL_EXT_DIR/no_header_out.csv' (header false);
eval select * from read_csv('$FILE_SQL_EXT_DIR/no_header_out.csv', header = false);

--echo # unknown options, options of another format, missing files and wrong formats
--error 1235
eval select * from read_csv('$FILE_SQL_EXT_DIR/types.csv', no_such_option = 1);
--error 1235
eval select * from read_parquet('$FILE_SQL_EXT_DIR/items.parquet', header = true);
--error 1017
eval select * from read_csv('$FILE_SQL_EXT_DIR/missing.csv');
--replace_regex /file '[^']*'/file '<path>'/
--error 11121
eval select * from read_parquet('$FILE_SQL_EXT_DIR/types.csv');

--echo # the feature switch also covers glob and COPY
set session enable_file_sql = OFF;
--error 1235
eval select count(*) from glob('$FILE_SQL_EXT_DIR/*');
--error 1235
eval copy (select 1) to '$FILE_SQL_EXT_DIR/off.csv';
set session enable_file_sql = ON;
eval select substring_index(file, '/', -1) as file from glob('$FILE_SQL_EXT_DIR/*.csv') order by file;

set session enable_file_sql = OFF;
--exec rm -rf $FILE_SQL_EXT_DIR
--enable_query_log
