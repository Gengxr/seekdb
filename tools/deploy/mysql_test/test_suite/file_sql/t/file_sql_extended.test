# owner: database-competition
# owner group: SQL
# description: File SQL options, type inference, error diagnostics, Parquet row groups, joins,
#              COPY and the feature switch. The fixtures are written by the test client, so
#              the client and the observer must share the file system.
# tags: sql,executor,file_sql

--disable_query_log
let $FILE_SQL_EXT_DIR = $OBSERVER_DIR/data_for_mysqltest_file_sql_ext;
--exec rm -rf $FILE_SQL_EXT_DIR && mkdir -p $FILE_SQL_EXT_DIR

--write_file $FILE_SQL_EXT_DIR/orders.csv
order_id;customer;amount;paid;note
1;alice;10.5;true;"first; with delimiter"
2;bob;NA;false;NA
3;alice;7;true;"line one
line two"
4;carol;20.25;false;"doubled ""quote"""
EOF

--write_file $FILE_SQL_EXT_DIR/escapes.csv
id,text
1,"backslash \"escaped\" quote"
2,"comma, inside"
EOF

--write_file $FILE_SQL_EXT_DIR/types.csv
i,d,b,mixed,dt,bad_date,big,neg,empty_col
1,1.5,true,1,2026-01-01,2026-02-30,9223372036854775807,-9223372036854775808,
2,2,FALSE,x,2026-01-02 03:04:05.123,2024-02-29,9223372036854775808,-1,
EOF

--write_file $FILE_SQL_EXT_DIR/bad_rows.csv
id,v
1,10
2
3,30
EOF

--write_file $FILE_SQL_EXT_DIR/unterminated.csv
id,v
1,"open
EOF

--write_file $FILE_SQL_EXT_DIR/no_header.csv
skipped line
7,seven
8,eight
EOF

--write_file $FILE_SQL_EXT_DIR/customers.jsonl
{"customer":"alice","city":"Hangzhou","since":"2020-01-01"}

{"customer":"bob","city":"Beijing","vip":true}
{"Customer":"carol","since":"2021-06-30","vip":false,"score":3}
{"customer":"dave","score":"n/a"}
EOF

--write_file $FILE_SQL_EXT_DIR/nested.jsonl
{"a":1}
{"a":[1,2]}
EOF

--write_file $FILE_SQL_EXT_DIR/broken.jsonl
{"a":1}
{"a":2,}
EOF

